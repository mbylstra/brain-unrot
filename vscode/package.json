{
  "name": "brain-unrot",
  "displayName": "Brain Unrot",
  "description": "A quiz about your codebase to answer while Claude works",
  "version": "0.1.0",
  "publisher": "mbylstra",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mbylstra/brain-unrot"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "brainUnrot.showQuiz",
        "title": "Brain Unrot: Show Quiz"
      }
    ],
    "configuration": {
      "title": "Brain Unrot",
      "properties": {
        "brainUnrot.claudePath": {
          "type": "string",
          "default": "",
          "description": "Path to the claude CLI. When empty, it's found through your login shell."
        },
        "brainUnrot.reopenOnPrompt": {
          "type": "boolean",
          "default": true,
          "description": "Open the quiz again when you send Claude a prompt after you closed it. When off, it stays closed until you run Brain Unrot: Show Quiz."
        }
      }
    }
  },
  "scripts": {
    "build": "vite build --config vite.extension.config.mts && vite build --config vite.webview.config.mts",
    "watch": "vite build --config vite.extension.config.mts --watch & vite build --config vite.webview.config.mts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run build"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.90",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/vsce": "^3.9.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.61.0",
    "marked": "^15.0.12",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.18.3"
}
